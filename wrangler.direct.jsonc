{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gateway-tapes",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "gateway.cows.wtf",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gateway-tapes-db",
      "database_id": "3f8d3ab9-e6ff-4bbb-a83d-e3629645a4d8",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gateway-tapes-audio"
    }
  ],
  "observability": {
    "enabled": true
  }
}
